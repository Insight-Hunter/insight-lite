{
  "name": "@insighthunter/insight-lite",
  "version": "3.0.1",
  "description": "InsightHunter Lite – SPA + Cloudflare Worker for the Lite tier",
  "type": "module",

  "main": "dist-worker/index.mjs",
  "types": "dist-worker/index.d.ts",

  "scripts": {
    "dev": "vite",

    "build:spa": "vite build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "build:types": "tsc --emitDeclarationOnly",

    "build": "npm run build:spa && npm run build:worker && npm run build:types",

    "dev:worker": "wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy",

    "lint": "eslint ."
  },

  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.454.0"
  },

  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.90.0",
    "eslint": "^9.0.0",
    "esbuild": "^0.24.0"
  },

  "engines": {
    "node": ">=18"
  }
}
